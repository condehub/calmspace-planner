rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation functions
    function isValidUser(data) {
      return data.xp is int && data.xp >= 0
        && data.level is int && data.level >= 1
        && data.spoonsUsed is int && data.spoonsUsed >= 0
        && data.maxSpoons is int && data.maxSpoons >= 0
        && data.badges is map
        && data.badges.firstStep is bool
        && data.badges.microMaster is bool
        && data.badges.deepFocus is bool
        && data.badges.energized is bool
        && data.badges.levelUp is bool
        && data.keys().hasAll(['xp', 'level', 'spoonsUsed', 'maxSpoons', 'badges'])
        && data.keys().size() <= 6;
    }

    function isValidTask(data) {
      return data.id is string
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.spoons is int && (data.spoons == 1 || data.spoons == 2 || data.spoons == 3)
        && data.completed is bool
        && data.dayOfWeek is string && data.dayOfWeek.size() <= 50
        && data.priority is string && (data.priority == 'Low' || data.priority == 'Medium' || data.priority == 'High')
        && data.subtasks is list
        && data.createdAt is string
        && (!data.keys().hasAny(['rewarded']) || data.rewarded is bool)
        && (!data.keys().hasAny(['overdue']) || data.overdue is bool)
        && data.keys().hasAll(['id', 'title', 'spoons', 'completed', 'dayOfWeek', 'priority', 'subtasks'])
        && data.keys().size() <= 10;
    }

    // Match patterns
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isEmailVerified() && isValidUser(incoming());
      allow update: if isOwner(userId) && isEmailVerified() && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasAny(['xp', 'level', 'spoonsUsed', 'maxSpoons', 'badges', 'updatedAt'])
      );
      allow delete: if false;

      // Tasks subcollection
      match /tasks/{taskId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isEmailVerified() && isValidId(taskId) && isValidTask(incoming());
        allow update: if isOwner(userId) && isEmailVerified() && isValidId(taskId) && isValidTask(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasAny(['completed', 'dayOfWeek', 'priority', 'title', 'spoons', 'subtasks'])
        );
        allow delete: if isOwner(userId) && isEmailVerified() && isValidId(taskId);
      }
    }
  }
}
